# ─── Supabase ────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# .env.local is in .gitignore — never commit it.
#
# The ANON key is intentionally public (restricted by RLS), but rotate it
# after any accidental exposure (git history, screenshots, etc.).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Academy metadata (safe to expose) ───────────────────────────────────────
VITE_ACADEMY_NAME=ChessKidoo Academy
VITE_ACADEMY_EMAIL=Chesskidoo37@gmail.com
VITE_ACADEMY_PHONE=+91 90258 46663
VITE_ACADEMY_CITY=Chennai, Tamil Nadu
VITE_ACADEMY_UPI_ID=9025846663@upi
VITE_ACADEMY_UPI_NAME=Ranjith A S

# ─── Payment (Razorpay) ──────────────────────────────────────────────────────
# Test key:  rzp_test_XXXXXXXXXXXXXXXX
# Live key:  rzp_live_XXXXXXXXXXXXXXXX   <- never commit the live key
VITE_RAZORPAY_KEY=rzp_test_REPLACE_WITH_YOUR_KEY

# ─── Admin ───────────────────────────────────────────────────────────────────
# UUID of the admin user in Supabase Auth
VITE_ADMIN_UUID=a007b0b0-9b30-478f-a147-1af18dff20ce

# ─── Server-side only (Supabase Edge Functions / CI) ─────────────────────────
# These must NEVER appear in client-side code.
# Set them in: Supabase Dashboard -> Project Settings -> Edge Function Secrets
# SUPABASE_SERVICE_ROLE_KEY=...
# RESEND_API_KEY=...         <- replaces EmailJS; stays server-side
